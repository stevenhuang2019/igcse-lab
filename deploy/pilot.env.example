# Set in the hosting platform's private environment configuration.
# Never put real credentials in this example.
IGCSE_PUBLIC_ORIGIN=https://your-private-test-host.example
IGCSE_PILOT_USERS_FILE=/data/pilot/users.json
IGCSE_PILOT_USAGE_FILE=/data/pilot/usage.json
IGCSE_PILOT_AI_ENABLED=false
IGCSE_PILOT_USER_DAILY_LIMIT=20
IGCSE_PILOT_GLOBAL_DAILY_LIMIT=100
IGCSE_AI_PROVIDER=deepseek
PORT=4174
# DEEPSEEK_API_KEY is configured privately by the administrator.
