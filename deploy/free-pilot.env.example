# Configure privately in Render. Do not put credentials in Git.
IGCSE_PUBLIC_ORIGIN=https://your-service.onrender.com
IGCSE_PILOT_STORAGE=environment
# Paste the complete users.json generated locally by pilot_users.cjs, never passwords.
IGCSE_PILOT_USERS_JSON=[]
IGCSE_PILOT_AI_ENABLED=true
IGCSE_AI_PROVIDER=deepseek
IGCSE_PILOT_USER_DAILY_LIMIT=20
IGCSE_PILOT_GLOBAL_DAILY_LIMIT=60
# DEEPSEEK_API_KEY: set privately in the platform, never here.
# In this free mode these counters reset on service restart AND each UTC day.
